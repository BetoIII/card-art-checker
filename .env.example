# Claude API — powers the managed agent that analyzes card art
ANTHROPIC_API_KEY=

# Rocketlane — pulls project info + uploads PDF reports to Space Documents
ROCKETLANE_API_KEY=

# Slack — posts compliance results to customer channels (ext-{name}-rain)
SLACK_BOT_TOKEN=

# Slack — Rocketlane integration bot user that auto-creates ext-{name}-rain
# channels; the channel identifier filters on this creator. Optional —
# defaults to U07DS8F9STS in code.
ROCKETLANE_SLACK_BOT_ID=

# Slack — internal notifications channel (channel-identify misses, delivery
# failures). Invite the card-art-checker bot to this channel once.
SLACK_NOTIFY_CHANNEL_ID=

# Optional — model for the slack-identifier sub-agent (default claude-sonnet-4-6)
SLACK_IDENTIFY_MODEL=

# Rocketlane — shared secret the form-completed webhook sends (Bearer or
# X-Webhook-Secret header); gates /api/card-art-check
ROCKETLANE_WEBHOOK_SECRET=

# Dock (dock.us) — signing secret for the Card Art Checker webhook
# (Settings → Webhooks → View Secret Key); verifies X-Dock-Signature on /api/dock-webhook
DOCK_WEBHOOK_SECRET=

# Admin dashboard — password for the /admin login form (also accepted as
# Basic Auth with any username on /api/admin/* for curl/scripts)
ADMIN_PASSWORD=

# Vercel Blob — stores generated PDF reports (permanent URLs for Rocketlane links)
BLOB_READ_WRITE_TOKEN=

# Claude Managed Agent — created by: node scripts/setup-agent.js
AGENT_ID=
ENV_ID=

# Anthropic Files API file ID for scripts/check_technical_specs.py
# Created by setup-agent.js — mounted into agent sessions at /mnt/session/scripts/
SPEC_SCRIPT_FILE_ID=
