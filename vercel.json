{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self' *.rocketlane.com" }
      ]
    }
  ],
  "functions": {
    "api/card-check.js": {
      "maxDuration": 300,
      "includeFiles": "assets/templates/**"
    },
    "api/card-art-check.js": {
      "maxDuration": 300,
      "includeFiles": "assets/templates/**"
    },
    "api/dock-webhook.js": {
      "maxDuration": 300,
      "includeFiles": "assets/templates/**"
    },
    "api/card-deliver.js": {
      "maxDuration": 300
    },
    "api/result.js": {
      "maxDuration": 30
    },
    "api/spec-check.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules/**,public/**,*.html,prompts/**}"
    }
  },
  "rewrites": [
    { "source": "/upload", "destination": "/upload.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/reference", "destination": "/reference.html" },
    { "source": "/api/card-art-check/:projectId", "destination": "/api/card-art-check?projectId=:projectId" },
    { "source": "/api/result/:runId", "destination": "/api/result?runId=:runId" }
  ]
}
